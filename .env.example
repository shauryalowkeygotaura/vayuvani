# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# CPCB API (register at https://cpcbccr.nic.in)
CPCB_API_KEY=your-cpcb-api-key

# OpenAQ (no key needed for basic usage, optional for higher rate limits)
OPENAQ_API_KEY=

# Logging
LOG_LEVEL=INFO

# Kaun? attribution engine
# Cron needs the service_role key (writes under RLS); the anon key fails pre-flight.
SUPABASE_SERVICE_KEY=
# NASA FIRMS fire points: free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Optional: CPCB real-time feed via data.gov.in (free key at https://data.gov.in, "My Account" -> API key)
DATA_GOV_IN_API_KEY=
# Optional, verify each address first: {"MCD": "...", "DPCC": "...", "Delhi Traffic Police": "..."}
KAUN_AGENCY_CONTACTS=
